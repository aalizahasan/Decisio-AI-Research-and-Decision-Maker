# ==============================================================================
# AI Research & Decision Platform — Environment Configuration Template
# ==============================================================================
# Why Environment Variables are Important:
# Environment variables allow us to configure server hosts, API ports, debug flags,
# and secret API keys dynamically across different environments (Development, Staging,
# Production) without hardcoding them into source code.
#
# DO NOT put actual API keys or secret values into version control.
# Copy this file to '.env' locally for actual configuration.
# ==============================================================================

# Backend Server Configuration
APP_NAME="AI Research & Decision Platform API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Cross-Origin Resource Sharing (CORS) Settings
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

